# Abyss Hunter API — seamless wallet backend (mirrors Bingo-System's provider seam)

PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=https://nextbytegames.com

# Provider seam. MOCK keeps wallet/launch calls local until real provider URLs
# are supplied (same idea as Bingo's MOCK_EXTERNAL_API_MODE).
MOCK_EXTERNAL_API_MODE=true
MOCK_START_BALANCE=10000
CURRENCY=USD
GAME_TYPE=FISH_ABYSS

# Real partner (used when MOCK_EXTERNAL_API_MODE=false). HMAC scheme is identical
# to Bingo/HappyHippo: canonical ts+METHOD+sortedQuery+rawBody, e2e-ts/e2e-sig.
PARTNER_CALLBACK_BASE_URL=
PARTNER_WEBHOOK_SECRET=
PARTNER_SLUG=abyss
PARTNER_TIMEOUT_MS=10000

# Launch-token verification (partner mints HMAC(`${userId}.${ts}`, LAUNCH_SECRET)).
LAUNCH_SECRET=

# Server-to-server auth for /api/admin/* (Authorization: Bearer <key> or x-game-api-key).
GAME_API_KEY=
